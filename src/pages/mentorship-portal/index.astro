---
import Layout from "@/components/layout.astro";
import { SITE } from "@/config";
import { getSupabase } from "@/lib/supabase";

// Fetch every cohort + its bootcamp sessions on each request — admin can edit
// these in the dashboard and changes appear here without a redeploy.
export const prerender = false;

const sb = getSupabase();
const { data: cohortRows = [] } = await sb
  .from("cohorts")
  .select("id,slug,label,program,dates,status")
  .neq("status", "Closed")
  .order("created_at", { ascending: false });

const { data: sessionRows = [] } = await sb
  .from("bootcamp_sessions")
  .select("id,cohort_id,short_day,date_label,iso_date,time_label,title,speaker,description,position,pdf_path,pdf_filename")
  .order("position", { ascending: true });

// Shape data the way the legacy inline script expects.
const COHORTS = (cohortRows ?? []).map((c) => ({
  id: c.slug,        // the script keys session/profile state on this — slug is stable + URL-friendly
  slug: c.slug,
  label: c.label,
  program: c.program,
  dates: c.dates ?? "",
  status: c.status,
}));

const sessionsByCohort: Record<string, any[]> = {};
for (const s of sessionRows ?? []) {
  // Map cohort_id → slug so the client can look up by cohort.id (= slug above).
  const cohort = (cohortRows ?? []).find((c) => c.id === s.cohort_id);
  const key = cohort?.slug;
  if (!key) continue;
  (sessionsByCohort[key] ??= []).push({
    id: s.id,
    shortDay: s.short_day ?? "",
    date: s.date_label ?? "",
    isoDate: s.iso_date ?? "",
    time: s.time_label ?? "",
    title: s.title,
    speaker: s.speaker ?? "",
    description: s.description ?? "",
    hasPdf: !!s.pdf_path,
    pdfFilename: s.pdf_filename ?? "",
  });
}

// First (most recent active) cohort drives the default render. Switching
// cohorts in the UI replaces the sessions list client-side from `sessionsByCohort`.
const defaultCohortKey = COHORTS[0]?.slug ?? "";
const sessions = sessionsByCohort[defaultCohortKey] ?? [];
---

<Layout
  title={`Mentorship Portal | ${SITE.title}`}
  description="MAIR Mentorship Program participant portal — May 2026 cohort bootcamp schedule and attendance."
>
  <!-- ===================================================== -->
  <!-- SCREEN 1 — Cohort selection                           -->
  <!-- ===================================================== -->
  <div id="screen-cohort" class="min-h-screen bg-neutral-light-30">
    <div class="main border-b border-neutral-dark-10/[0.06] py-4 md:py-6">
      <a href="/" aria-label="MAIR home">
        <img
          src="/logo2.png"
          alt="MAIR Logo"
          class="h-auto w-[90px] md:w-[110px]"
        />
      </a>
    </div>

    <main class="main relative py-16 md:py-28">
      <!-- subtle decorative gradient blob -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute right-1/2 top-0 -z-10 h-[520px] w-[520px] translate-x-[180px] rounded-full bg-gradient-to-br from-teal-60/[0.07] via-teal-60/[0.03] to-transparent blur-3xl md:translate-x-[280px]"
      >
      </div>

      <div class="mx-auto max-w-xl">
        <div
          class="mb-5 inline-flex items-center gap-2 rounded-full border border-teal-60/25 bg-teal-60/[0.04] px-3 py-1"
        >
          <span class="relative flex h-1.5 w-1.5">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-60 opacity-60"
            ></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-teal-60"></span>
          </span>
          <span
            class="font-mono text-paragraph-xs font-semibold uppercase tracking-[0.18em] text-teal-60"
          >
            MAIR Programs
          </span>
        </div>
        <h1
          class="mb-3 font-sans text-heading-lg font-bold leading-[1.05] tracking-tight text-neutral-dark-10 md:text-[44px]"
        >
          Mentorship Portal
        </h1>
        <p class="mb-12 text-paragraph-lg leading-relaxed text-neutral-dark-30">
          Pick your cohort to continue. You'll need the email and access code shared with you by the program team.
        </p>

        <div id="cohort-list" class="flex flex-col gap-4">
          <!-- populated by JS -->
        </div>
      </div>
    </main>
  </div>

  <!-- ===================================================== -->
  <!-- SCREEN 2 — Login                                      -->
  <!-- ===================================================== -->
  <div id="screen-login" class="hidden min-h-screen bg-neutral-light-30">
    <div class="main border-b border-neutral-dark-10/[0.06] py-4 md:py-6">
      <a href="/" aria-label="MAIR home">
        <img
          src="/logo2.png"
          alt="MAIR Logo"
          class="h-auto w-[90px] md:w-[110px]"
        />
      </a>
    </div>

    <main class="main py-14 md:py-24">
      <div class="mx-auto max-w-md">
        <button
          id="back-to-cohort"
          class="mb-8 flex items-center gap-1.5 font-mono text-paragraph-xs text-neutral-dark-30 transition-colors hover:text-neutral-dark-10"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          Choose a different cohort
        </button>

        <!-- Cohort badge -->
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-teal-60/30 bg-teal-60/5 px-4 py-1.5"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-teal-60"></span>
          <span
            id="login-cohort-label"
            class="font-mono text-paragraph-xs font-semibold uppercase tracking-widest text-teal-60"
          >
            MAY 2026
          </span>
        </div>

        <h2
          class="mb-2 font-sans text-heading-sm font-bold tracking-tight text-neutral-dark-10"
        >
          Access the portal
        </h2>
        <p class="text-paragraph-md mb-8 leading-relaxed text-neutral-dark-30">
          Enter the email address and access code shared with you when you joined the cohort.
        </p>

        <div
          class="rounded-2xl border border-neutral-dark-10/10 bg-white p-6 shadow-[0_2px_12px_-4px_rgba(0,0,0,0.08)] md:p-8"
        >
          <form id="login-form" novalidate class="flex flex-col gap-5">
            <!-- Email -->
            <div class="flex flex-col gap-2">
              <label
                for="login-email"
                class="font-mono text-paragraph-xs font-semibold uppercase tracking-widest text-neutral-dark-30"
              >
                Email address
              </label>
              <div class="relative">
                <svg
                  aria-hidden="true"
                  class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-dark-30/40"
                  width="16" height="16" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
                <input
                  id="login-email"
                  type="email"
                  autocomplete="email"
                  placeholder="you@example.com"
                  class="w-full rounded-lg border border-neutral-dark-10/20 bg-neutral-light-30 px-4 py-3 pl-10 font-mono text-paragraph-sm text-neutral-dark-10 placeholder-neutral-dark-30/40 transition-colors focus:border-teal-60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-60/20"
                />
              </div>
            </div>

            <!-- Access code -->
            <div class="flex flex-col gap-2">
              <label
                for="login-code"
                class="font-mono text-paragraph-xs font-semibold uppercase tracking-widest text-neutral-dark-30"
              >
                Access code
              </label>
              <div class="relative">
                <svg
                  aria-hidden="true"
                  class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-dark-30/40"
                  width="16" height="16" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <input
                  id="login-code"
                  type="password"
                  autocomplete="off"
                  placeholder="MAIR-XXXX"
                  class="w-full rounded-lg border border-neutral-dark-10/20 bg-neutral-light-30 px-4 py-3 pl-10 pr-12 font-mono text-paragraph-sm uppercase tracking-wider text-neutral-dark-10 placeholder-neutral-dark-30/40 transition-colors focus:border-teal-60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-60/20"
                />
                <button
                  type="button"
                  id="toggle-code-visibility"
                  aria-label="Show or hide code"
                  class="absolute right-3 top-1/2 -translate-y-1/2 rounded p-1 text-neutral-dark-30/50 transition-colors hover:text-neutral-dark-30"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Error message -->
            <p
              id="login-error"
              class="hidden flex items-start gap-2 rounded-lg border border-red-200 bg-red-50 px-4 py-3 font-mono text-paragraph-xs text-red-600"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span>Incorrect email or access code. Please check your details and try again.</span>
            </p>

            <!-- Submit -->
            <button
              type="submit"
              id="login-submit"
              class="mt-1 inline-flex items-center justify-center gap-2 rounded-lg bg-neutral-dark-10 px-6 py-3.5 font-sans text-paragraph-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-neutral-dark-10/90 active:scale-[0.99] disabled:opacity-60"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
              </svg>
              Access portal
            </button>
          </form>
        </div>

        <p class="mt-4 flex items-center gap-1.5 font-mono text-[11px] text-neutral-dark-30/70">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          Don't have an access code? Contact your program coordinator.
        </p>
      </div>
    </main>
  </div>

  <!-- ===================================================== -->
  <!-- SCREEN 3 — Portal                                     -->
  <!-- ===================================================== -->
  <div id="screen-portal" class="hidden min-h-screen">
    <!-- Header -->
    <div class="border-b border-neutral-dark-10/[0.06] bg-white">
      <div class="main flex items-center justify-between py-4 md:py-5">
        <a href="/" aria-label="MAIR home">
          <img
            src="/logo2.png"
            alt="MAIR Logo"
            class="h-auto w-[90px] md:w-[110px]"
          />
        </a>
        <button
          id="sign-out-btn"
          class="flex items-center gap-1.5 font-mono text-paragraph-xs text-neutral-dark-30 transition-colors hover:text-neutral-dark-10"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          Sign out
        </button>
      </div>
    </div>

    <!-- Welcome banner -->
    <section class="relative overflow-hidden bg-gradient-to-b from-neutral-light-30 to-white py-12 md:py-16">
      <!-- decorative gradient -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-32 right-0 h-[480px] w-[480px] rounded-full bg-gradient-to-br from-teal-60/[0.08] via-teal-60/[0.03] to-transparent blur-3xl"
      ></div>

      <div class="main relative">
        <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <div
              class="mb-3 inline-flex items-center gap-2 rounded-full border border-teal-60/25 bg-teal-60/[0.04] px-3 py-1"
            >
              <span class="relative flex h-1.5 w-1.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-60 opacity-60"></span>
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-teal-60"></span>
              </span>
              <span
                id="portal-cohort-label"
                class="font-mono text-paragraph-xs font-semibold uppercase tracking-widest text-teal-60"
              >
                MAY 2026
              </span>
            </div>
            <h1
              class="mb-2 font-sans text-heading-lg font-bold leading-[1.05] tracking-tight text-neutral-dark-10 md:text-[44px]"
            >
              Welcome, <span id="welcome-name" class="text-teal-60">—</span>
            </h1>
            <p class="text-paragraph-md text-neutral-dark-30">
              MAIR Mentorship Program &middot; Bootcamp: May 6 – 10, 2026
            </p>
          </div>

          <!-- Attendance ring card -->
          <div
            class="flex items-center gap-5 rounded-2xl border border-neutral-dark-10/10 bg-white/80 p-5 shadow-[0_2px_12px_-4px_rgba(0,0,0,0.06)] backdrop-blur md:p-6"
          >
            <!-- SVG progress ring (54px radius, stroke 8). Circumference ≈ 339.3 -->
            <div class="relative h-[110px] w-[110px] shrink-0">
              <svg viewBox="0 0 120 120" class="h-full w-full -rotate-90">
                <circle cx="60" cy="60" r="54" fill="none" stroke="currentColor" stroke-width="8" class="text-neutral-dark-10/[0.08]" />
                <circle
                  id="attendance-bar"
                  cx="60" cy="60" r="54" fill="none"
                  stroke="currentColor" stroke-width="8" stroke-linecap="round"
                  class="text-teal-60 transition-all duration-700"
                  stroke-dasharray="339.292"
                  stroke-dashoffset="339.292"
                />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span
                  id="attendance-label"
                  class="font-sans text-heading-xs font-bold leading-none text-neutral-dark-10"
                >
                  0 / {sessions.length}
                </span>
                <span class="mt-1 font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/60">Sessions</span>
              </div>
            </div>
            <div class="min-w-0">
              <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-neutral-dark-30/60">Your attendance</p>
              <p class="mt-1 font-sans text-paragraph-md font-bold text-neutral-dark-10">Track your progress</p>
              <p class="mt-1 max-w-[180px] text-paragraph-xs leading-snug text-neutral-dark-30">
                Mark each session as you attend it.
              </p>
            </div>
          </div>
        </div>

        <!-- Profile card -->
        <div
          class="mt-8 rounded-xl border border-neutral-dark-10/10 bg-white p-6 shadow-sm md:p-8"
        >
          <!-- Card header -->
          <div class="mb-5 flex items-center justify-between">
            <p
              class="font-mono text-paragraph-xs font-semibold uppercase tracking-[0.18em] text-neutral-dark-30/60"
            >
              Your Profile
            </p>
            <div class="flex items-center gap-2">
              <button
                id="edit-profile-btn"
                class="flex items-center gap-1.5 rounded-lg border border-neutral-dark-10/15 px-3 py-1.5 font-mono text-paragraph-xs text-neutral-dark-30 transition-colors hover:border-teal-60 hover:text-teal-60"
              >
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                  ></path>
                  <path
                    d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                  ></path>
                </svg>
                Edit
              </button>
              <button
                id="save-profile-btn"
                class="hidden rounded-lg bg-teal-60 px-4 py-1.5 font-sans text-paragraph-xs font-bold text-white transition-colors hover:bg-teal-60/85"
              >
                Save changes
              </button>
              <button
                id="cancel-profile-btn"
                class="hidden rounded-lg border border-neutral-dark-10/15 px-3 py-1.5 font-mono text-paragraph-xs text-neutral-dark-30 transition-colors hover:text-neutral-dark-10"
              >
                Cancel
              </button>
            </div>
          </div>

          <!-- ── VIEW MODE ── -->
          <div id="profile-view">
            <div class="mb-5 flex items-center gap-4">
              <div
                id="profile-avatar"
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-teal-60/15 font-sans text-label-sm font-bold text-teal-60"
              >
                --
              </div>
              <div>
                <p
                  id="profile-name"
                  class="font-sans text-label-sm font-bold text-neutral-dark-10"
                >
                  —
                </p>
                <p
                  id="profile-email"
                  class="font-mono text-paragraph-xs text-neutral-dark-30"
                >
                  —
                </p>
                <div
                  id="profile-links-view"
                  class="mt-2 hidden items-center gap-3"
                >
                  <a
                    id="profile-linkedin-link"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1 font-mono text-paragraph-xs text-neutral-dark-30 transition-colors hover:text-teal-60"
                  >
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      ><path
                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                      ></path><rect x="2" y="9" width="4" height="12"
                      ></rect><circle cx="4" cy="4" r="2"></circle></svg
                    >
                    LinkedIn
                  </a>
                  <a
                    id="profile-website-link"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1 font-mono text-paragraph-xs text-neutral-dark-30 transition-colors hover:text-teal-60"
                  >
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><circle cx="12" cy="12" r="10"></circle><line
                        x1="2"
                        y1="12"
                        x2="22"
                        y2="12"></line><path
                        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                      ></path></svg
                    >
                    Website
                  </a>
                </div>
              </div>
            </div>

            <div
              class="border-neutral-dark-10/8 grid grid-cols-1 gap-5 border-t pt-5 sm:grid-cols-2"
            >
              <div>
                <p
                  class="mb-1 font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/50"
                >
                  University
                </p>
                <p
                  id="profile-university"
                  class="text-paragraph-sm text-neutral-dark-10"
                >
                  —
                </p>
              </div>
              <div>
                <p
                  class="mb-1 font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/50"
                >
                  Year of PhD
                </p>
                <p
                  id="profile-phd-year"
                  class="text-paragraph-sm text-neutral-dark-10"
                >
                  —
                </p>
              </div>
              <div class="sm:col-span-2">
                <p
                  class="mb-1 font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/50"
                >
                  Thesis Subject
                </p>
                <p
                  id="profile-thesis"
                  class="text-paragraph-sm text-neutral-dark-10"
                >
                  —
                </p>
              </div>
            </div>
          </div>

          <!-- ── EDIT MODE ── -->
          <div id="profile-edit" class="hidden">
            <!-- Name row -->
            <div class="mb-5 flex items-start gap-4">
              <div
                id="profile-avatar-edit"
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-teal-60/15 font-sans text-label-sm font-bold text-teal-60"
              >
                --
              </div>
              <div class="flex-1 space-y-3">
                <div>
                  <label
                    for="edit-name"
                    class="mb-1 block font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/50"
                  >
                    Full name
                  </label>
                  <input
                    id="edit-name"
                    type="text"
                    class="w-full rounded-lg border border-neutral-dark-10/20 bg-neutral-light-30 px-3 py-2 font-sans text-paragraph-sm text-neutral-dark-10 placeholder-neutral-dark-30/40 transition-colors focus:border-teal-60 focus:outline-none focus:ring-2 focus:ring-teal-60/20"
                  />
                </div>
                <p class="font-mono text-paragraph-xs text-neutral-dark-30/50">
                  Email: <span
                    id="edit-email-display"
                    class="text-neutral-dark-30">—</span
                  >
                </p>
              </div>
            </div>

            <!-- Detail fields grid -->
            <div
              class="border-neutral-dark-10/8 grid grid-cols-1 gap-4 border-t pt-5 sm:grid-cols-2"
            >
              <div>
                <label
                  for="edit-university"
                  class="mb-1 block font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/50"
                >
                  University
                </label>
                <input
                  id="edit-university"
                  type="text"
                  placeholder="Your university"
                  class="w-full rounded-lg border border-neutral-dark-10/20 bg-neutral-light-30 px-3 py-2 font-sans text-paragraph-sm text-neutral-dark-10 placeholder-neutral-dark-30/40 transition-colors focus:border-teal-60 focus:outline-none focus:ring-2 focus:ring-teal-60/20"
                />
              </div>
              <div>
                <label
                  for="edit-phd-year"
                  class="mb-1 block font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/50"
                >
                  Year of PhD
                </label>
                <input id="edit-phd-year" type="hidden" value="" />
                <div
                  id="edit-phd-year-buttons"
                  class="flex flex-wrap gap-2"
                  role="radiogroup"
                  aria-label="Year of PhD"
                >
                  <button
                    type="button"
                    data-phd-year="1"
                    class="phd-year-btn rounded-lg border border-neutral-dark-10/20 bg-neutral-light-30 px-3 py-2 font-sans text-paragraph-sm text-neutral-dark-10 transition-colors hover:border-teal-60/60 hover:bg-teal-60/5 focus:outline-none focus:ring-2 focus:ring-teal-60/20"
                  >
                    First year
                  </button>
                  <button
                    type="button"
                    data-phd-year="2"
                    class="phd-year-btn rounded-lg border border-neutral-dark-10/20 bg-neutral-light-30 px-3 py-2 font-sans text-paragraph-sm text-neutral-dark-10 transition-colors hover:border-teal-60/60 hover:bg-teal-60/5 focus:outline-none focus:ring-2 focus:ring-teal-60/20"
                  >
                    Second year
                  </button>
                  <button
                    type="button"
                    data-phd-year="3"
                    class="phd-year-btn rounded-lg border border-neutral-dark-10/20 bg-neutral-light-30 px-3 py-2 font-sans text-paragraph-sm text-neutral-dark-10 transition-colors hover:border-teal-60/60 hover:bg-teal-60/5 focus:outline-none focus:ring-2 focus:ring-teal-60/20"
                  >
                    Third year
                  </button>
                  <button
                    type="button"
                    data-phd-year="4"
                    class="phd-year-btn rounded-lg border border-neutral-dark-10/20 bg-neutral-light-30 px-3 py-2 font-sans text-paragraph-sm text-neutral-dark-10 transition-colors hover:border-teal-60/60 hover:bg-teal-60/5 focus:outline-none focus:ring-2 focus:ring-teal-60/20"
                  >
                    Fourth year
                  </button>
                </div>
              </div>
              <div class="sm:col-span-2">
                <label
                  for="edit-thesis"
                  class="mb-1 block font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/50"
                >
                  Thesis Subject
                </label>
                <input
                  id="edit-thesis"
                  type="text"
                  placeholder="Your research topic"
                  class="w-full rounded-lg border border-neutral-dark-10/20 bg-neutral-light-30 px-3 py-2 font-sans text-paragraph-sm text-neutral-dark-10 placeholder-neutral-dark-30/40 transition-colors focus:border-teal-60 focus:outline-none focus:ring-2 focus:ring-teal-60/20"
                />
              </div>
              <div>
                <label
                  for="edit-linkedin"
                  class="mb-1 block font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/50"
                >
                  LinkedIn
                </label>
                <input
                  id="edit-linkedin"
                  type="url"
                  placeholder="https://linkedin.com/in/…"
                  class="w-full rounded-lg border border-neutral-dark-10/20 bg-neutral-light-30 px-3 py-2 font-sans text-paragraph-sm text-neutral-dark-10 placeholder-neutral-dark-30/40 transition-colors focus:border-teal-60 focus:outline-none focus:ring-2 focus:ring-teal-60/20"
                />
              </div>
              <div>
                <label
                  for="edit-website"
                  class="mb-1 block font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/50"
                >
                  Website
                </label>
                <input
                  id="edit-website"
                  type="url"
                  placeholder="https://yoursite.com"
                  class="w-full rounded-lg border border-neutral-dark-10/20 bg-neutral-light-30 px-3 py-2 font-sans text-paragraph-sm text-neutral-dark-10 placeholder-neutral-dark-30/40 transition-colors focus:border-teal-60 focus:outline-none focus:ring-2 focus:ring-teal-60/20"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tabbed: Schedule + Cohort Members -->
    <section class="bg-white py-14 md:py-20">
      <div class="main">
        <!-- Tab bar -->
        <div
          role="tablist"
          aria-label="Portal sections"
          class="mb-8 flex flex-wrap gap-2 border-b border-neutral-dark-10/10"
        >
          <button
            type="button"
            id="tab-schedule"
            role="tab"
            aria-selected="true"
            aria-controls="pane-schedule"
            class="portal-tab -mb-px border-b-2 border-teal-60 px-4 py-2 font-sans text-paragraph-sm font-semibold text-teal-60 transition-colors focus:outline-none"
          >
            Bootcamp Schedule
          </button>
          <button
            type="button"
            id="tab-members"
            role="tab"
            aria-selected="false"
            aria-controls="pane-members"
            class="portal-tab -mb-px border-b-2 border-transparent px-4 py-2 font-sans text-paragraph-sm font-semibold text-neutral-dark-30 transition-colors hover:text-neutral-dark-10 focus:outline-none"
          >
            Cohort Members
          </button>
        </div>

        <!-- Pane: Schedule -->
        <div id="pane-schedule" role="tabpanel" aria-labelledby="tab-schedule">
          <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p
                class="mb-2 font-mono text-paragraph-xs font-semibold uppercase tracking-[0.18em] text-teal-60"
              >
                May 6 – May 10, 2026
              </p>
              <h2
                class="mb-2 font-sans text-heading-sm font-bold tracking-tight text-neutral-dark-10"
              >
                Bootcamp Schedule
              </h2>
              <p class="text-paragraph-md leading-relaxed text-neutral-dark-30">
                Attendance is recorded by the program coordinators after each session.
                Your status updates here automatically.
              </p>
            </div>
          </div>

          <div id="sessions-list" class="flex flex-col gap-4">
            <!-- populated by JS -->
          </div>
        </div>

        <!-- Pane: Cohort Members -->
        <div
          id="pane-members"
          role="tabpanel"
          aria-labelledby="tab-members"
          class="hidden"
        >
          <div class="mb-10">
            <p
              class="mb-2 font-mono text-paragraph-xs font-semibold uppercase tracking-[0.18em] text-teal-60"
            >
              Your cohort
            </p>
            <h2
              class="mb-2 font-sans text-heading-sm font-bold tracking-tight text-neutral-dark-10"
            >
              Cohort Members
            </h2>
            <p class="text-paragraph-md leading-relaxed text-neutral-dark-30">
              Fellow participants in your cohort. Reach out — many great
              collaborations start here.
            </p>
          </div>

          <p
            id="members-loading"
            class="hidden py-6 text-center font-mono text-paragraph-xs text-neutral-dark-30/60"
          >
            Loading…
          </p>
          <p
            id="members-error"
            class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 font-mono text-paragraph-xs text-red-700"
          ></p>
          <div
            id="members-grid"
            class="grid grid-cols-1 gap-4 sm:grid-cols-2"
          >
            <!-- populated by JS -->
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script is:inline define:vars={{ sessions, COHORTS, sessionsByCohort }}>
  // Profile data for the logged-in participant. Populated by the server on
  // login, persisted to localStorage so reloads don't require re-entering the
  // code. Access codes never live in the browser past form submission.
  // Attendance is also server-controlled (admin marks it) — the portal only
  // displays the result; participants can no longer self-mark.
  let serverProfile = null;
  const LS_SESSION = "mair_portal_session";
  const LS_ATTENDANCE = "mair_portal_attendance";

  // ---- DOM refs ----
  const screenCohort = document.getElementById("screen-cohort");
  const screenLogin = document.getElementById("screen-login");
  const screenPortal = document.getElementById("screen-portal");

  const cohortListEl = document.getElementById("cohort-list");
  const loginCohortLabel = document.getElementById("login-cohort-label");
  const portalCohortLabel = document.getElementById("portal-cohort-label");
  const backToCohortBtn = document.getElementById("back-to-cohort");
  const loginForm = document.getElementById("login-form");
  const loginEmailEl = document.getElementById("login-email");
  const loginCodeEl = document.getElementById("login-code");
  const loginErrorEl = document.getElementById("login-error");
  const signOutBtn = document.getElementById("sign-out-btn");
  const welcomeNameEl = document.getElementById("welcome-name");
  const sessionsListEl = document.getElementById("sessions-list");
  const attendanceLabelEl = document.getElementById("attendance-label");
  const tabScheduleBtn = document.getElementById("tab-schedule");
  const tabMembersBtn = document.getElementById("tab-members");
  const paneScheduleEl = document.getElementById("pane-schedule");
  const paneMembersEl = document.getElementById("pane-members");
  const membersGridEl = document.getElementById("members-grid");
  const membersLoadingEl = document.getElementById("members-loading");
  const membersErrorEl = document.getElementById("members-error");
  let membersLoaded = false;
  const attendanceBarEl = document.getElementById("attendance-bar");

  // ---- State ----
  let selectedCohort = null;
  let participant = null; // { name, email }
  let attendance = {};

  function loadState() {
    try {
      const raw = localStorage.getItem(LS_SESSION);
      if (raw) {
        const saved = JSON.parse(raw);
        participant = { name: saved.name, email: saved.email };
        selectedCohort = COHORTS.find(c => c.id === saved.cohortId) || null;
        // Restore the cached profile so the portal renders without re-login.
        // If the cache is missing (cleared, different browser), the user is
        // sent back to the login screen by the boot logic below.
        serverProfile = loadServerProfile(saved.email);
      }
    } catch {
      /* ignore invalid stored session */
    }
    // Attendance now comes from the server (admin-controlled). We rebuild it
    // from the cached profile's attendedSessionIds so reloads don't flicker.
    attendance = attendanceFromProfile(serverProfile);
  }

  function attendanceFromProfile(profile) {
    const map = {};
    if (profile && Array.isArray(profile.attendedSessionIds)) {
      for (const id of profile.attendedSessionIds) map[id] = true;
    }
    return map;
  }

  function saveSession() {
    localStorage.setItem(
      LS_SESSION,
      JSON.stringify({
        name: participant.name,
        email: participant.email,
        cohortId: selectedCohort.id,
      })
    );
  }

  function saveAttendance() {
    // Attendance is read-only on the portal — admin controls it server-side.
    // Function kept as a no-op so any stale callers don't error.
  }

  function clearSession() {
    localStorage.removeItem(LS_SESSION);
    participant = null;
    selectedCohort = null;
  }

  // ---- Screen transitions ----

  function show(screen) {
    [screenCohort, screenLogin, screenPortal].forEach(s =>
      s.classList.add("hidden")
    );
    screen.classList.remove("hidden");
    window.scrollTo(0, 0);
  }

  function goToCohortScreen() {
    renderCohorts();
    show(screenCohort);
  }

  function goToLoginScreen(cohort) {
    selectedCohort = cohort;
    loginCohortLabel.textContent = cohort.label;
    loginErrorEl.classList.add("hidden");
    loginEmailEl.value = "";
    loginCodeEl.value = "";
    show(screenLogin);
    loginEmailEl.focus();
  }

  // ---- Profile editing ----

  const LS_PROFILE = "mair_portal_profile";
  let profileOverrides = {};

  function loadProfileOverrides() {
    try {
      const raw = localStorage.getItem(`${LS_PROFILE}_${participant.email}`);
      profileOverrides = raw ? JSON.parse(raw) : {};
    } catch {
      profileOverrides = {};
    }
  }

  function saveProfileOverrides() {
    localStorage.setItem(
      `${LS_PROFILE}_${participant.email}`,
      JSON.stringify(profileOverrides)
    );
  }

  function getEffectiveProfile() {
    // serverProfile is populated by the login API and cached in localStorage.
    const cred = serverProfile || {};
    return {
      name: profileOverrides.name ?? cred.name ?? "",
      email: participant.email,
      university: profileOverrides.university ?? cred.university ?? "",
      phdYear: profileOverrides.phdYear ?? cred.phdYear ?? "",
      thesis: profileOverrides.thesis ?? cred.thesis ?? "",
      linkedin: profileOverrides.linkedin ?? cred.linkedin ?? "",
      website: profileOverrides.website ?? cred.website ?? "",
    };
  }

  const PHD_YEAR_LABELS = {
    1: "First year",
    2: "Second year",
    3: "Third year",
    4: "Fourth year",
  };

  function formatPhdYear(v) {
    const n = typeof v === "number" ? v : parseInt(v, 10);
    return PHD_YEAR_LABELS[n] || "—";
  }

  // Sync hidden input + visual active state on the segmented buttons.
  // Empty string clears the selection.
  function setEditPhdYear(value) {
    const hidden = document.getElementById("edit-phd-year");
    hidden.value = value == null ? "" : String(value);
    document.querySelectorAll("#edit-phd-year-buttons [data-phd-year]")
      .forEach((btn) => {
        const active = btn.dataset.phdYear === hidden.value;
        btn.classList.toggle("border-teal-60", active);
        btn.classList.toggle("bg-teal-60/10", active);
        btn.classList.toggle("text-teal-60", active);
        btn.classList.toggle("font-medium", active);
        btn.setAttribute("aria-checked", active ? "true" : "false");
      });
  }

  function initials(name) {
    return (name || "?")
      .split(" ")
      .map(n => n[0])
      .join("")
      .slice(0, 2)
      .toUpperCase();
  }

  function populateProfile() {
    const p = getEffectiveProfile();

    // Avatar (both view and edit share the same initials)
    const ini = initials(p.name);
    document.getElementById("profile-avatar").textContent = ini;
    document.getElementById("profile-avatar-edit").textContent = ini;

    // View mode fields
    document.getElementById("profile-name").textContent = p.name || "—";
    document.getElementById("profile-email").textContent = p.email || "—";
    document.getElementById("profile-university").textContent =
      p.university || "—";
    document.getElementById("profile-phd-year").textContent = formatPhdYear(p.phdYear);
    document.getElementById("profile-thesis").textContent = p.thesis || "—";

    // Social links
    const linksView = document.getElementById("profile-links-view");
    const linkedinLink = document.getElementById("profile-linkedin-link");
    const websiteLink = document.getElementById("profile-website-link");

    linkedinLink.classList.toggle("hidden", !p.linkedin);
    websiteLink.classList.toggle("hidden", !p.website);

    if (p.linkedin) linkedinLink.href = p.linkedin;
    if (p.website) websiteLink.href = p.website;

    linksView.classList.toggle("hidden", !p.linkedin && !p.website);
    linksView.classList.toggle("flex", !!(p.linkedin || p.website));

    // Update welcome name if name changed
    welcomeNameEl.textContent = p.name || participant.name;
  }

  function enterEditMode() {
    const p = getEffectiveProfile();
    document.getElementById("edit-name").value = p.name;
    document.getElementById("edit-email-display").textContent = p.email;
    document.getElementById("edit-university").value = p.university;
    setEditPhdYear(
      p.phdYear == null || p.phdYear === "" ? "" : String(p.phdYear),
    );
    document.getElementById("edit-thesis").value = p.thesis;
    document.getElementById("edit-linkedin").value = p.linkedin;
    document.getElementById("edit-website").value = p.website;

    document.getElementById("profile-view").classList.add("hidden");
    document.getElementById("profile-edit").classList.remove("hidden");
    document.getElementById("edit-profile-btn").classList.add("hidden");
    document.getElementById("save-profile-btn").classList.remove("hidden");
    document.getElementById("cancel-profile-btn").classList.remove("hidden");

    document.getElementById("edit-name").focus();
  }

  function exitEditMode() {
    document.getElementById("profile-view").classList.remove("hidden");
    document.getElementById("profile-edit").classList.add("hidden");
    document.getElementById("edit-profile-btn").classList.remove("hidden");
    document.getElementById("save-profile-btn").classList.add("hidden");
    document.getElementById("cancel-profile-btn").classList.add("hidden");
  }

  async function saveProfile() {
    const payload = {
      name: document.getElementById("edit-name").value.trim(),
      university: document.getElementById("edit-university").value.trim(),
      phd_year: (() => {
        const v = document.getElementById("edit-phd-year").value;
        return v === "" ? null : parseInt(v, 10);
      })(),
      thesis: document.getElementById("edit-thesis").value.trim(),
      linkedin: document.getElementById("edit-linkedin").value.trim(),
      website: document.getElementById("edit-website").value.trim(),
    };

    const saveBtn = document.getElementById("save-profile-btn");
    const prevText = saveBtn ? saveBtn.textContent : "";
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = "Saving…";
    }

    try {
      const res = await fetch("/api/mentorship/profile.json", {
        method: "PATCH",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        const j = await res.json().catch(() => ({}));
        alert(j.error || "Failed to save profile.");
        return;
      }
      const j = await res.json();
      // Server response is source of truth — clear local overrides + reset cache.
      profileOverrides = {};
      saveProfileOverrides();
      saveServerProfile(j.profile);
      // Update participant name shown in the welcome banner.
      participant.name = j.profile.name || participant.email;
      saveSession();
      populateProfile();
      exitEditMode();
    } catch (e) {
      alert("Network error — please try again.");
    } finally {
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = prevText;
      }
    }
  }

  function goToPortal() {
    welcomeNameEl.textContent = participant.name;
    portalCohortLabel.textContent = selectedCohort.label;
    loadProfileOverrides();
    populateProfile();
    renderSessions();
    updateProgress();
    show(screenPortal);
  }

  // ---- Auth ----

  // Cache the verified profile so reload doesn't require a re-login round-trip.
  function saveServerProfile(profile) {
    if (!profile) return;
    serverProfile = profile;
    try {
      localStorage.setItem(
        `mair_portal_profile_server_${profile.email.toLowerCase()}`,
        JSON.stringify(profile)
      );
    } catch {}
  }

  function loadServerProfile(email) {
    if (!email) return null;
    try {
      const raw = localStorage.getItem(
        `mair_portal_profile_server_${email.toLowerCase()}`
      );
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  async function handleLogin(e) {
    e.preventDefault();
    const email = loginEmailEl.value.trim().toLowerCase();
    const code = loginCodeEl.value.trim().toUpperCase();
    if (!selectedCohort) return;

    loginErrorEl.classList.add("hidden");
    const submitBtn = loginForm.querySelector("button[type=submit]");
    const prevText = submitBtn ? submitBtn.textContent : "";
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Signing in…";
    }

    try {
      const res = await fetch("/api/mentorship/login.json", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          cohortSlug: selectedCohort.slug || selectedCohort.id,
          email,
          code,
        }),
      });
      if (!res.ok) {
        loginErrorEl.classList.remove("hidden");
        loginCodeEl.value = "";
        loginCodeEl.focus();
        return;
      }
      const j = await res.json();
      participant = { name: j.profile.name || email, email: j.profile.email };
      saveServerProfile(j.profile);
      saveSession();
      // Replace the in-memory sessions array with this cohort's schedule.
      const fresh = sessionsByCohort[selectedCohort.id] || [];
      sessions.length = 0;
      fresh.forEach(s => sessions.push(s));
      // Refresh attendance from the server profile (admin-controlled).
      attendance = attendanceFromProfile(j.profile);
      goToPortal();
    } catch {
      loginErrorEl.classList.remove("hidden");
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = prevText;
      }
    }
  }

  // ---- Attendance (read-only — admin marks via dashboard) ----

  function toggleAttendance(_sessionId) {
    // Attendance is admin-controlled. Self-marking is disabled.
  }

  function updateProgress() {
    const total = sessions.length;
    const attended = sessions.filter(s => attendance[s.id]).length;
    attendanceLabelEl.textContent = `${attended} / ${total}`;
    // Ring uses stroke-dashoffset. Circumference for r=54 → 2π·54 ≈ 339.292.
    const circumference = 339.292;
    const ratio = total > 0 ? attended / total : 0;
    attendanceBarEl.setAttribute(
      "stroke-dashoffset",
      String(circumference * (1 - ratio))
    );
  }

  // ---- Render: cohort cards ----

  function renderCohorts() {
    cohortListEl.innerHTML = COHORTS.map(c => {
      const isActive = (c.status || "").toLowerCase() === "active";
      const statusBadge = isActive
        ? `<span class="inline-flex items-center gap-1.5 rounded-full bg-teal-60/10 px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-widest text-teal-60">
             <span class="relative flex h-1.5 w-1.5">
               <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-60 opacity-60"></span>
               <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-teal-60"></span>
             </span>
             Live
           </span>`
        : `<span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-dark-10/[0.06] px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30">${c.status}</span>`;

      return `
      <button
        class="cohort-btn group relative w-full overflow-hidden rounded-2xl border border-neutral-dark-10/10 bg-white p-6 text-left transition-all duration-300 hover:-translate-y-0.5 hover:border-teal-60/40 hover:shadow-[0_8px_24px_-8px_rgba(0,128,128,0.18)] md:p-8"
        data-cohort-id="${c.id}"
      >
        <span aria-hidden="true" class="absolute inset-y-0 left-0 w-[3px] bg-teal-60 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0 flex-1">
            <div class="mb-4 flex flex-wrap items-center gap-2">
              ${statusBadge}
              <span class="font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/60">${c.program}</span>
            </div>
            <h3 class="mb-2 font-sans text-heading-sm font-bold tracking-tight text-neutral-dark-10">${c.label}</h3>
            ${c.dates ? `<p class="flex items-center gap-1.5 text-paragraph-sm text-neutral-dark-30">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-dark-30/60"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              ${c.dates}
            </p>` : ""}
          </div>
          <div class="shrink-0 self-center rounded-full border border-neutral-dark-10/10 bg-white p-2.5 text-neutral-dark-30/40 transition-all duration-300 group-hover:border-teal-60/40 group-hover:bg-teal-60 group-hover:text-white">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </div>
      </button>
    `;
    }).join("");

    cohortListEl.querySelectorAll(".cohort-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const cohort = COHORTS.find(c => c.id === btn.dataset.cohortId);
        if (cohort) goToLoginScreen(cohort);
      });
    });
  }

  // ---- Render: session cards ----

  function sessionState(isoDate) {
    if (!isoDate) return "upcoming";
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const target = new Date(isoDate);
    target.setHours(0, 0, 0, 0);
    if (target.getTime() === today.getTime()) return "today";
    return target < today ? "past" : "upcoming";
  }

  function isSessionPast(isoDate) {
    return sessionState(isoDate) === "past";
  }

  function speakerInitials(name) {
    return (name || "?")
      .split(" ")
      .filter(Boolean)
      .map(n => n[0])
      .join("")
      .slice(0, 2)
      .toUpperCase();
  }

  function escapeHTML(s) {
    return String(s ?? "").replace(/[&<>"']/g, c =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]
    );
  }

  function sessionCardHTML(s) {
    const present = !!attendance[s.id];
    const state = sessionState(s.isoDate);
    const past = state === "past";
    const today = state === "today";

    // Card visual state — present > today > default
    const cardBorder = present
      ? "border-teal-60 bg-gradient-to-br from-teal-60/[0.06] to-white"
      : today
        ? "border-amber-300 bg-gradient-to-br from-amber-50/60 to-white"
        : "border-neutral-dark-10/10 bg-white hover:border-neutral-dark-10/20";

    // Date pill background
    const badgeBg = present
      ? "bg-teal-60 text-white shadow-[0_4px_12px_-2px_rgba(0,128,128,0.4)]"
      : today
        ? "bg-amber-500 text-white shadow-[0_4px_12px_-2px_rgba(245,158,11,0.4)]"
        : past
          ? "bg-neutral-dark-10/[0.06] text-neutral-dark-20"
          : "bg-white text-neutral-dark-10 ring-1 ring-neutral-dark-10/12";

    // Status pill styling — replaces the formerly-clickable button. Read-only.
    const btnClasses = present
      ? "bg-teal-60 text-white"
      : past
        ? "bg-neutral-dark-10/[0.05] text-neutral-dark-30/60 ring-1 ring-neutral-dark-10/10"
        : today
          ? "bg-amber-50 text-amber-700 ring-1 ring-amber-200"
          : "bg-neutral-light-30 text-neutral-dark-30 ring-1 ring-neutral-dark-10/10";

    // Status tag rendered inside the card
    const statusTag = present
      ? `<span class="inline-flex items-center gap-1 rounded-full bg-teal-60/10 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-widest text-teal-60">
           <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
           Attended
         </span>`
      : today
        ? `<span class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-widest text-amber-700">
             <span class="relative flex h-1.5 w-1.5">
               <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-500 opacity-60"></span>
               <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-amber-500"></span>
             </span>
             Today
           </span>`
        : past
          ? `<span class="inline-flex items-center rounded-full bg-neutral-dark-10/[0.06] px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/60">Past</span>`
          : `<span class="inline-flex items-center rounded-full bg-neutral-dark-10/[0.04] px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-widest text-neutral-dark-30/70">Upcoming</span>`;

    // Read-only label per state. Admin controls who is marked present.
    const btnContent = present
      ? `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>Marked present`
      : today
        ? `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>Live today`
        : past
          ? `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>Not marked`
          : `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>Upcoming`;

    const speakerInit = speakerInitials(s.speaker);
    const safeTitle = escapeHTML(s.title);
    const safeSpeaker = escapeHTML(s.speaker);
    const safeDescription = escapeHTML(s.description);
    const safeShortDay = escapeHTML(s.shortDay);
    const safeDate = escapeHTML(s.date);
    const safeTime = escapeHTML(s.time);

    return `
      <div data-card="${s.id}" class="group flex flex-col gap-5 rounded-2xl border p-5 transition-all duration-300 md:flex-row md:items-start md:gap-6 md:p-6 ${cardBorder}">
        <!-- Date pill -->
        <div class="flex shrink-0 items-center gap-3 md:flex-col md:items-start md:gap-3">
          <div class="flex w-[72px] flex-col items-center rounded-xl px-3 py-3 text-center transition-all ${badgeBg}">
            <span class="font-mono text-[10px] font-bold uppercase tracking-widest leading-none opacity-80">${safeShortDay}</span>
            <span class="mt-1 font-sans text-paragraph-md font-bold leading-tight">${safeDate}</span>
          </div>
        </div>

        <!-- Body -->
        <div class="min-w-0 flex-1">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            ${statusTag}
            ${safeTime ? `<span class="font-mono text-paragraph-xs text-neutral-dark-30/60">${safeTime}</span>` : ""}
          </div>
          <h3 class="font-sans text-label-md font-bold leading-snug tracking-tight text-neutral-dark-10">${safeTitle}</h3>
          ${safeSpeaker ? `
            <div class="mt-2 flex items-center gap-2">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-60/15 font-mono text-[10px] font-bold uppercase tracking-tight text-teal-60">${speakerInit}</span>
              <span class="font-sans text-paragraph-sm font-medium text-neutral-dark-20">${safeSpeaker}</span>
            </div>` : ""}
          ${safeDescription ? `<p class="mt-3 text-paragraph-sm leading-relaxed text-neutral-dark-30">${safeDescription}</p>` : ""}
          ${s.hasPdf ? `
            <button
              type="button"
              data-pdf-session="${s.id}"
              class="session-pdf-btn mt-3 inline-flex items-center gap-2 rounded-lg border border-teal-60/30 bg-teal-60/5 px-3 py-1.5 font-mono text-paragraph-xs font-semibold uppercase tracking-wider text-teal-60 transition-colors hover:border-teal-60 hover:bg-teal-60/10"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
              <span class="pdf-btn-label">Download slides</span>
            </button>
          ` : ""}
        </div>

        <!-- Status (read-only — attendance is set by an admin) -->
        <div class="shrink-0 md:self-center">
          <span
            class="attendance-status flex w-full select-none items-center justify-center gap-2 rounded-lg px-5 py-2.5 font-sans text-paragraph-sm font-semibold md:w-auto ${btnClasses}"
            data-session-id="${s.id}"
          >${btnContent}</span>
        </div>
      </div>
    `;
  }

  function renderSessions() {
    sessionsListEl.innerHTML = sessions.map(sessionCardHTML).join("");
    // No click bindings — attendance is read-only on the portal.
    // PDF downloads use a delegated handler bound once below.
  }

  // Delegated handler for "Download slides" buttons.
  // Cards are re-rendered on cohort switch / attendance update, so we delegate
  // off the parent container instead of binding per-card.
  sessionsListEl.addEventListener("click", async (ev) => {
    const btn = ev.target.closest("[data-pdf-session]");
    if (!btn) return;
    const sessionId = btn.dataset.pdfSession;
    const labelEl = btn.querySelector(".pdf-btn-label");
    const orig = labelEl ? labelEl.textContent : "";
    if (labelEl) labelEl.textContent = "Preparing…";
    btn.disabled = true;
    try {
      const res = await fetch(`/api/mentorship/sessions/${sessionId}/pdf.json`, {
        credentials: "same-origin",
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.url) {
        if (labelEl) labelEl.textContent = data.error || "Unavailable";
        setTimeout(() => { if (labelEl) labelEl.textContent = orig; }, 2500);
        return;
      }
      // Open in a new tab so the participant can preview before saving.
      window.open(data.url, "_blank", "noopener");
      if (labelEl) labelEl.textContent = orig;
    } catch (e) {
      if (labelEl) labelEl.textContent = "Network error";
      setTimeout(() => { if (labelEl) labelEl.textContent = orig; }, 2500);
    } finally {
      btn.disabled = false;
    }
  });

  function updateSessionCard(sessionId) {
    const old = sessionsListEl.querySelector(`[data-card="${sessionId}"]`);
    const session = sessions.find(s => s.id === sessionId);
    if (!old || !session) return;
    const tmp = document.createElement("div");
    tmp.innerHTML = sessionCardHTML(session);
    old.replaceWith(tmp.firstElementChild);
  }

  // ---- Event listeners ----

  backToCohortBtn.addEventListener("click", goToCohortScreen);
  signOutBtn.addEventListener("click", async () => {
    try {
      await fetch("/api/mentorship/logout.json", {
        method: "POST",
        credentials: "same-origin",
      });
    } catch {
      /* even if it fails, clear local state */
    }
    clearSession();
    goToCohortScreen();
  });
  loginForm.addEventListener("submit", handleLogin);

  document
    .getElementById("edit-profile-btn")
    .addEventListener("click", enterEditMode);
  document
    .getElementById("save-profile-btn")
    .addEventListener("click", saveProfile);
  document
    .getElementById("cancel-profile-btn")
    .addEventListener("click", exitEditMode);

  // Year-of-PhD segmented buttons: click to select, click active to clear.
  document.querySelectorAll("#edit-phd-year-buttons [data-phd-year]")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const v = btn.dataset.phdYear;
        const current = document.getElementById("edit-phd-year").value;
        setEditPhdYear(current === v ? "" : v);
      });
    });

  // Tabs: Schedule ↔ Cohort Members. Members are fetched on first activation.
  tabScheduleBtn.addEventListener("click", () => switchTab("schedule"));
  tabMembersBtn.addEventListener("click", () => switchTab("members"));

  function switchTab(name) {
    const onSchedule = name === "schedule";
    paneScheduleEl.classList.toggle("hidden", !onSchedule);
    paneMembersEl.classList.toggle("hidden", onSchedule);

    for (const [btn, active] of [
      [tabScheduleBtn, onSchedule],
      [tabMembersBtn, !onSchedule],
    ]) {
      btn.setAttribute("aria-selected", active ? "true" : "false");
      btn.classList.toggle("border-teal-60", active);
      btn.classList.toggle("text-teal-60", active);
      btn.classList.toggle("border-transparent", !active);
      btn.classList.toggle("text-neutral-dark-30", !active);
    }

    if (!onSchedule && !membersLoaded) loadCohortMembers();
  }

  async function loadCohortMembers() {
    membersLoaded = true;
    membersErrorEl.classList.add("hidden");
    membersLoadingEl.classList.remove("hidden");
    membersGridEl.innerHTML = "";
    try {
      const res = await fetch("/api/mentorship/cohort.json", {
        credentials: "same-origin",
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const members = Array.isArray(data.members) ? data.members : [];
      if (members.length === 0) {
        membersGridEl.innerHTML =
          '<p class="col-span-full py-6 text-center font-mono text-paragraph-xs text-neutral-dark-30/60">No other members yet.</p>';
      } else {
        membersGridEl.innerHTML = members.map(memberCardHTML).join("");
      }
    } catch (e) {
      membersLoaded = false; // allow retry on next switch
      membersErrorEl.textContent =
        "Could not load cohort members. Try switching tabs again.";
      membersErrorEl.classList.remove("hidden");
    } finally {
      membersLoadingEl.classList.add("hidden");
    }
  }

  function escapeHtml(s) {
    return String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function memberCardHTML(m) {
    const name = escapeHtml(m.name || m.email || "—");
    const ini = initials(m.name || m.email);
    const uni = m.university ? escapeHtml(m.university) : "";
    const yr = formatPhdYear(m.phdYear);
    const yrShown = yr === "—" ? "" : yr;
    const meta = [uni, yrShown].filter(Boolean).join(" · ");
    const youTag = m.isSelf
      ? '<span class="ml-2 rounded-full bg-teal-60/10 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase text-teal-60">You</span>'
      : "";

    const linkedinHref = m.linkedin ? escapeHtml(m.linkedin) : "";
    const websiteHref = m.website ? escapeHtml(m.website) : "";
    const emailHref = m.email ? `mailto:${escapeHtml(m.email)}` : "";

    const iconBtn = (href, opensNew, label, svg) =>
      `<a href="${href}"${opensNew ? ' target="_blank" rel="noopener"' : ""} aria-label="${label}" title="${label}" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-neutral-dark-10/15 text-neutral-dark-30 transition-colors hover:border-teal-60 hover:bg-teal-60/5 hover:text-teal-60">${svg}</a>`;

    const mailSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`;
    const linkedinSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>`;
    const globeSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`;

    const links = [];
    if (emailHref) links.push(iconBtn(emailHref, false, "Email", mailSvg));
    if (linkedinHref) links.push(iconBtn(linkedinHref, true, "LinkedIn", linkedinSvg));
    if (websiteHref) links.push(iconBtn(websiteHref, true, "Website", globeSvg));

    return `
      <article class="flex flex-col gap-3 rounded-2xl border border-neutral-dark-10/10 bg-white p-5 transition-colors hover:border-teal-60/40 ${m.isSelf ? "ring-1 ring-teal-60/20" : ""}">
        <div class="flex items-start gap-3">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-teal-60/15 font-sans text-label-sm font-bold text-teal-60">
            ${escapeHtml(ini)}
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center">
              <h3 class="truncate font-sans text-paragraph-md font-semibold text-neutral-dark-10">${name}</h3>
              ${youTag}
            </div>
            ${meta ? `<p class="mt-0.5 truncate font-mono text-paragraph-xs text-neutral-dark-30">${escapeHtml(meta)}</p>` : ""}
          </div>
        </div>
        ${links.length ? `<div class="flex flex-wrap gap-2">${links.join("")}</div>` : ""}
      </article>
    `;
  }

  // Allow showing the password via double-click on the code field label
  document
    .querySelector('[for="login-code"]')
    ?.addEventListener("dblclick", () => {
      loginCodeEl.type = loginCodeEl.type === "password" ? "text" : "password";
    });

  // Eye toggle next to the code input
  document
    .getElementById("toggle-code-visibility")
    ?.addEventListener("click", () => {
      loginCodeEl.type = loginCodeEl.type === "password" ? "text" : "password";
    });

  // ---- Init ----

  // Apply a freshly-fetched server profile (from /api/mentorship/me) into all
  // the in-memory state — replaces attendance + profile fields.
  function applyFreshProfile(data) {
    if (!data || !data.profile) return;
    const cohortFromServer = COHORTS.find(c => c.slug === data.cohort.slug)
      || { ...data.cohort, id: data.cohort.slug };
    selectedCohort = cohortFromServer;
    participant = {
      name: data.profile.name || data.profile.email,
      email: data.profile.email,
    };
    saveServerProfile(data.profile);
    saveSession();
    const fresh = sessionsByCohort[selectedCohort.id] || [];
    sessions.length = 0;
    fresh.forEach(s => sessions.push(s));
    attendance = attendanceFromProfile(data.profile);
  }

  // Refresh attendance silently after the page has booted (admin may have
  // updated it). Quiet failure → keep current view.
  async function refreshFromServer({ silent } = { silent: true }) {
    try {
      const res = await fetch("/api/mentorship/me.json", { credentials: "same-origin" });
      if (res.status === 401) {
        if (!silent) clearSession();
        return false;
      }
      if (!res.ok) return false;
      const data = await res.json();
      applyFreshProfile(data);
      // If we're on the portal screen, repaint with new state.
      if (!screenPortal.classList.contains("hidden")) {
        populateProfile();
        renderSessions();
        updateProgress();
      }
      return true;
    } catch {
      return false;
    }
  }

  loadState();
  // Try to use a server-side session cookie first — that's the source of truth.
  refreshFromServer({ silent: false }).then(ok => {
    if (ok) {
      goToPortal();
    } else if (participant && selectedCohort && serverProfile) {
      // Fallback: stale localStorage cache (cookie expired). Show what we have,
      // user can still navigate but attendance won't refresh until next login.
      const fresh = sessionsByCohort[selectedCohort.id] || [];
      sessions.length = 0;
      fresh.forEach(s => sessions.push(s));
      goToPortal();
    } else {
      clearSession();
      goToCohortScreen();
    }
  });

  // Auto-refresh when the tab regains focus — admin may have just marked attendance.
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible" && participant) {
      refreshFromServer({ silent: true });
    }
  });
</script>
