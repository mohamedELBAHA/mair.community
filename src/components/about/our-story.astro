---
import TimelineItem, { type TimelineItemType } from "./timeline-item.astro";
import comu from "@/assets/about/comu.png";
import { Icon } from "astro-icon/components";
import { ButtonLink } from "@/components/button";

const STORY_TIMELINE: Array<TimelineItemType & { description: string }> = [
  {
    title: "",
    description:
      "MAIR (Moroccans in AI Research) was born from a simple realization: Morocco has no shortage of brilliant minds in artificial intelligence, but their stories are often invisible — scattered across the globe, disconnected from one another, and overlooked at home. I saw the need for a platform that could bring them together, amplify their voices, and create bridges between those thriving in top international labs and the young researchers in Morocco eager to follow the same path. That’s how MAIR started — as a movement to connect, mentor, and make Moroccan AI talent visible on both the national and global stage. From the very beginning, it was never just about research — it was about community, opportunity, and the belief that Morocco’s contribution to AI deserves to be seen and celebrated.",
    images: {
      mobile: comu,
      tablet: comu,
      fhd: comu,
      uhd: comu,
    },
  },
];
---

<section id="our-story" class="bg-neutral-light-30">
  <div class="main mx-auto">
    <div
      class="flex flex-col items-center py-20 md:flex-row md:justify-between"
    >
      <h2
        class="mb-4 text-center text-heading-lg font-bold text-neutral-dark-10 sm:text-left"
      >
        How it all started?
      </h2>
      <a
        href="#team"
        class="flex items-center gap-2 text-label-sm font-bold text-neutral-dark-10 hover:text-neutral-dark-20"
      >
        Go to Team members
        <Icon name="arrow-down-right" class="h-5 w-5" />
      </a>
    </div>

    {
      STORY_TIMELINE.map(item => (
        <TimelineItem {...item}>
          <p class="text-paragraph-md text-neutral-dark-20 2xl:text-paragraph-lg">
            <Fragment set:html={item.description} />
          </p>
          <div class="mt-6 flex justify-center">
            <ButtonLink
              href="https://medium.com/@elbahamohamed/why-moroccan-ai-researchers-need-a-community-and-how-mair-is-building-it-13b3995b172f"
              target="_blank"
              rel="noopener noreferrer"
              variant="primary"
              size="lg"
            >
              discover our why
            </ButtonLink>
          </div>
        </TimelineItem>
      ))
    }
  </div>
</section>
